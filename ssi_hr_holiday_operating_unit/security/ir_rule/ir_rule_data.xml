<odoo>
<!-- Leave -->
<record id="hr_leave_rule_ou" model="ir.rule">
    <field name="name">hr.leave - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_hr_holiday.model_hr_leave" />
    <field name="groups" eval="[(4, ref('hr_leave_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
<!-- Leave Allocation -->
<record id="hr_leave_allocation_rule_ou" model="ir.rule">
    <field name="name">hr.leave_allocation - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_hr_holiday.model_hr_leave_allocation" />
    <field name="groups" eval="[(4, ref('hr_leave_allocation_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
