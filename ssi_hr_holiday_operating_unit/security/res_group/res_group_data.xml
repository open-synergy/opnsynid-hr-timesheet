<odoo>
<!-- Data Ownership -->
<!-- Leave -->
<record id="hr_leave_ou_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_hr_holiday.hr_leave_data_ownership_module_category"
        />
</record>

<record id="ssi_hr_holiday.leave_company_group" model="res.groups">
    <field name="name">Company</field>
    <field
            name="category_id"
            ref="ssi_hr_holiday.hr_leave_data_ownership_module_category"
        />
    <field name="implied_ids" eval="[(4, ref('hr_leave_ou_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

<!-- Leave Allocation-->
<record id="hr_leave_allocation_ou_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_hr_holiday.hr_leave_allocation_data_ownership_module_category"
        />
</record>

<record id="ssi_hr_holiday.leave_allocation_company_group" model="res.groups">
    <field name="name">Company</field>
    <field
            name="category_id"
            ref="ssi_hr_holiday.hr_leave_allocation_data_ownership_module_category"
        />
    <field name="implied_ids" eval="[(4, ref('hr_leave_allocation_ou_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>
</odoo>
