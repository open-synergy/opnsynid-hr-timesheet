<odoo>
<record id="hr_leave_allocation_view_search" model="ir.ui.view">
    <field name="name">hr.leave_allocation: Operating Unit Search</field>
    <field name="model">hr.leave_allocation</field>
    <field name="inherit_id" ref="ssi_hr_holiday.hr_leave_allocation_view_search" />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_leave_allocation_view_tree" model="ir.ui.view">
    <field name="name">hr.leave_allocation: Operating Unit Tree</field>
    <field name="model">hr.leave_allocation</field>
    <field name="inherit_id" ref="ssi_hr_holiday.hr_leave_allocation_view_tree" />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_leave_allocation_view_form" model="ir.ui.view">
    <field name="name">hr.leave_allocation: Operating Unit Form</field>
    <field name="model">hr.leave_allocation</field>
    <field name="inherit_id" ref="ssi_hr_holiday.hr_leave_allocation_view_form" />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
