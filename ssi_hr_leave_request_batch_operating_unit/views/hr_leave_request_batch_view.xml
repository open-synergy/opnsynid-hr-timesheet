<odoo>
<record id="hr_leave_request_batch_view_search" model="ir.ui.view">
    <field name="name">hr.leave_request_batch: Operating Unit Search</field>
    <field name="model">hr.leave_request_batch</field>
    <field
            name="inherit_id"
            ref="ssi_hr_leave_request_batch.hr_leave_request_batch_view_search"
        />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
            <xpath expr="//group[@name='group_by']" position="before">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                    optional="hide"
                />
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                    name="grp_ou"
                    string="Operating Unit"
                    context="{'group_by':'operating_unit_id'}"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </xpath>
    </field>
</record>

<record id="hr_leave_request_batch_view_tree" model="ir.ui.view">
    <field name="name">hr.leave_request_batch: Operating Unit Tree</field>
    <field name="model">hr.leave_request_batch</field>
    <field
            name="inherit_id"
            ref="ssi_hr_leave_request_batch.hr_leave_request_batch_view_tree"
        />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                    optional="hide"
                />
            </xpath>
    </field>
</record>

<record id="hr_leave_request_batch_view_form" model="ir.ui.view">
    <field name="name">hr.leave_request_batch: Operating Unit Form</field>
    <field name="model">hr.leave_request_batch</field>
    <field
            name="inherit_id"
            ref="ssi_hr_leave_request_batch.hr_leave_request_batch_view_form"
        />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                    optional="hide"
                />
            </xpath>
    </field>
</record>
</odoo>
