<odoo>
<record id="overtime_batch_rule_ou" model="ir.rule">
    <field name="name">hr.overtime_batch - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_hr_overtime_batch.model_hr_overtime_batch" />
    <field name="groups" eval="[(4, ref('overtime_batch_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
