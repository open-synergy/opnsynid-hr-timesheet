<odoo>
<record id="hr_attendance_location_view_search" model="ir.ui.view">
    <field name="name">hr.attendance_location - search</field>
    <field name="model">hr.attendance_location</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="hr_attendance_location_view_tree" model="ir.ui.view">
    <field name="name">hr.attendance_location - tree</field>
    <field name="model">hr.attendance_location</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="latitude" />
                <field name="longitude" />
                <field name="radius" />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_attendance_location_view_form" model="ir.ui.view">
    <field name="name">hr.attendance_location - form</field>
    <field name="model">hr.attendance_location</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="latitude" />
                <field name="longitude" />
                <field name="radius" />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_attendance_location_action" model="ir.actions.act_window">
    <field name="name">Attendance Location</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hr.attendance_location</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="hr_attendance_location_menu"
        name="Attendance Locations"
        parent="menu_hr_attendance_configuration"
        groups="hr_attendance_location_group"
        action="hr_attendance_location_action"
        sequence="3"
    />

</odoo>
