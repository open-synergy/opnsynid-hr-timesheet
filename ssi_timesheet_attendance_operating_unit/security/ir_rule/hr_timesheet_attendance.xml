<odoo>
<record id="hr_timesheet_attendance_rule_ou" model="ir.rule">
    <field
            name="name"
        >hr.timesheet_attendance - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_timesheet_attendance.model_hr_timesheet_attendance"
        />
    <field
            name="groups"
            eval="[(4, ref('ssi_timesheet_operating_unit.hr_timesheet_ou_group'))]"
        />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
