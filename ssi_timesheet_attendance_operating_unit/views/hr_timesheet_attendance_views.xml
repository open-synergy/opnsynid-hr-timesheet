<odoo>
<record id="hr_timesheet_attendance_view_search" model="ir.ui.view">
    <field name="name">hr.timesheet_attendance: Operating Unit Search</field>
    <field name="model">hr.timesheet_attendance</field>
    <field
            name="inherit_id"
            ref="ssi_timesheet_attendance.hr_timesheet_attendance_view_search"
        />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
                <group name="group_by">
                    <filter
                            name="grp_ou"
                            string="Operating Unit"
                            context="{'group_by':'operating_unit_id'}"
                            groups="operating_unit.group_multi_operating_unit"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="hr_timesheet_attendance_view_tree" model="ir.ui.view">
    <field name="name">hr.timesheet_attendance: Operating Unit Tree</field>
    <field name="model">hr.timesheet_attendance</field>
    <field
            name="inherit_id"
            ref="ssi_timesheet_attendance.hr_timesheet_attendance_view_tree"
        />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='state']" position="before">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_timesheet_attendance_view_form" model="ir.ui.view">
    <field name="name">hr.timesheet_attendance: Operating Unit Form</field>
    <field name="model">hr.timesheet_attendance</field>
    <field
            name="inherit_id"
            ref="ssi_timesheet_attendance.hr_timesheet_attendance_view_form"
        />
    <field name="priority" eval="30" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
