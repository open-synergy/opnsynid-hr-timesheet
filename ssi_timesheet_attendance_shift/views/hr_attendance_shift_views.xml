<odoo>
<record id="hr_attendance_shift_view_search" model="ir.ui.view">
    <field name="name">hr.attendance_shift - search</field>
    <field name="model">hr.attendance_shift</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="hr_attendance_shift_view_tree" model="ir.ui.view">
    <field name="name">hr.attendance_shift - tree</field>
    <field name="model">hr.attendance_shift</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="hour_start" />
                <field name="duration" />
                <field name="hour_end" />
                <field name="cross_day" />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_attendance_shift_view_form" model="ir.ui.view">
    <field name="name">hr.attendance_shift - form</field>
    <field name="model">hr.attendance_shift</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="hour_start" />
                <field name="duration" />
                <field name="hour_end" />
                <field name="cross_day" />
                <field name="early_check_in_tolerance" />
                <field name="late_check_out_tolerance" />
            </xpath>
        </data>
    </field>
</record>

<record id="hr_attendance_shift_action" model="ir.actions.act_window">
    <field name="name">Attendance Shifts</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hr.attendance_shift</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="hr_attendance_shift_menu"
        name="Attendance Shifts"
        parent="ssi_timesheet_attendance.menu_hr_attendance_configuration"
        groups="attendance_shift_group"
        action="hr_attendance_shift_action"
        sequence="3"
    />

</odoo>
