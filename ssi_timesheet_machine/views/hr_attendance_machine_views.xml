<odoo>
<record id="hr_attendance_machine_view_search" model="ir.ui.view">
    <field name="name">hr.attendance.machine.search</field>
    <field name="model">hr.attendance.machine</field>
    <field name="arch" type="xml">
        <search>
            <field name="pin"/>
            <field name="scan_date"/>
            <field name="verify"/>
            <field name="status_scan"/>
            <field name="employee_id"/>
            <field name="device_id"/>
            <field name="is_transfer"/>
            <separator />
            <filter
                    name="transferred"
                    string="Transferred"
                    domain="[('is_transfer', '=', True)]"
                />
            <filter
                    name="not_transferred"
                    string="Not Yet Transferred"
                    domain="[('is_transfer', '=', False)]"
                />
            <filter
                    name="grp_transfer"
                    string="Is Transfer?"
                    context="{'group_by':'is_transfer'}"
                />
        </search>
    </field>
</record>

<record id="hr_attendance_machine_view_tree" model="ir.ui.view">
    <field name="name">hr.attendance.machine.tree</field>
    <field name="model">hr.attendance.machine</field>
    <field name="arch" type="xml">
        <tree>
            <field name="pin"/>
            <field name="scan_date"/>
            <field name="verify"/>
            <field name="status_scan"/>
            <field name="employee_id"/>
            <field name="device_id"/>
            <field name="is_transfer"/>
        </tree>
    </field>
</record>

<record id="hr_attendance_machine_view_form" model="ir.ui.view">
    <field name="name">hr.attendance.machine.form</field>
    <field name="model">hr.attendance.machine</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group col="4">
                    <field name="pin"/>
                    <field name="scan_date"/>
                    <field name="verify"/>
                    <field name="status_scan"/>
                    <field name="employee_id"/>
                    <field name="device_id"/>
                    <field name="is_transfer"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="hr_attendance_machine_action" model="ir.actions.act_window">
    <field name="name">Data Machine</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hr.attendance.machine</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_not_transferred': True}</field>
</record>

<menuitem
        id="hr_attendance_machine_menu"
        name="Attendance Machine"
        parent="menu_hr_machine_transaction"
        action="hr_attendance_machine_action"
        sequence="20"
    />

<record id="action_generate_attendances" model="ir.actions.server">
    <field name="name">Generate Attendance</field>
    <field name="model_id" ref="ssi_timesheet_machine.model_hr_attendance_machine" />
    <field name="binding_model_id" ref="ssi_timesheet_machine.model_hr_attendance_machine" />
    <field name="state">code</field>
    <field name="code">records.action_generate_attendances()</field>
</record>
</odoo>
