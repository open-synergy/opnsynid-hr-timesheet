<odoo>
<record id="hr_machine_view_search" model="ir.ui.view">
    <field name="name">hr.machine - search</field>
    <field name="model">hr.machine</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="hr_machine_view_tree" model="ir.ui.view">
    <field name="name">hr.machine - tree</field>
    <field name="model">hr.machine</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="hr_machine_view_form" model="ir.ui.view">
    <field name="name">hr.machine - form</field>
    <field name="model">hr.machine</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//header" position="inside">
                <button name="action_test_connection" type="object" string="Test Connection"/>
            </xpath>
        </data>
    </field>
</record>

<record id="hr_machine_action" model="ir.actions.act_window">
    <field name="name">Data Machine</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hr.machine</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="hr_machine_menu"
        name="Data Machine"
        parent="menu_hr_machine_configuration"
        groups="hr_attendance_machine_group"
        action="hr_machine_action"
        sequence="1"
    />

</odoo>
