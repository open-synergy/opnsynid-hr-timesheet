<odoo>
<record id="hr_attendance_machine_import_wizard_form_views" model="ir.ui.view">
    <field name="name">hr.attendance.machine.import.wizard.form</field>
    <field name="model">hr.attendance.machine.import.wizard</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
        <form>
            <group col="4">
                <field name="datas" filename="datas_fname"/>
                <field name="datas_fname" force_save="1" invisible="1"/>
            </group>
            <footer>
                <button name="action_import" string="Import" type="object" class="oe_highlight"/> or
                <button string="Cancel" class="oe_link" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="hr_attendance_machine_import_wizard_action_xlsx" model="ir.actions.act_window">
    <field name="name">Import File CSV</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hr.attendance.machine.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="hr_attendance_machine_import_wizard_form_views"/>
    <field name="target">new</field>
</record>

<menuitem
        id="hr_attendance_machine_import_wizard_menu_xlsx"
        action="hr_attendance_machine_import_wizard_action_xlsx"
        parent="menu_hr_machine_transaction"
        sequence="10"
    />
</odoo>
