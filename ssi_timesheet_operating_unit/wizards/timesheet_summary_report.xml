<odoo>

    <record id="timesheet_summary_report_view_form" model="ir.ui.view">
        <field name="name">hr.timesheet_summary_report: Operating Unit Form</field>
        <field name="model">hr.timesheet_summary_report</field>
        <field
            name="inherit_id"
            ref="ssi_timesheet.timesheet_summary_report_view_form"
        />
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_end']" position="after">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </xpath>
        </field>
    </record>

</odoo>
